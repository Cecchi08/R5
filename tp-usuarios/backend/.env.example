DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=usuarios_db
JWT_SECRET=
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# Registrar cada REDIRECT_URI exactamente en el panel del proveedor, sin barra final.
# Son obligatorias al habilitar un proveedor; no se derivan de BACKEND_URL.
# Proveedores: google, facebook (Meta), github, x, discord, twitch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback
FACEBOOK_API_VERSION=v23.0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/auth/github/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/api/auth/x/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
